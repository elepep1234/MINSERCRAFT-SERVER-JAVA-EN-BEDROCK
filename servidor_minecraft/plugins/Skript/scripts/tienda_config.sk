# Configuración de tienda con EconomyShopGUI
# Creado para facilitar la creación de tiendas

command /configurartienda:
    permission: tienda.admin
    trigger:
        # Crear tienda principal
        make console execute command "eshop create TiendaPrincipal"
        wait 1 second
        
        # Crear categorías principales
        make console execute command "eshop category create Bloques"
        make console execute command "eshop category create Recursos"
        make console execute command "eshop category create Comida"
        make console execute command "eshop category create Herramientas"
        make console execute command "eshop category create Armas"
        make console execute command "eshop category create Armadura"
        make console execute command "eshop category create Decoración"
        make console execute command "eshop category create Especial"
        wait 1 second
        
        # Configurar precios de bloques comunes
        make console execute command "eshop add STONE 1 5"
        make console execute command "eshop add DIRT 1 3"
        make console execute command "eshop add GRASS_BLOCK 2 8"
        make console execute command "eshop add COBBLESTONE 1 4"
        make console execute command "eshop add OAK_LOG 3 12"
        make console execute command "eshop add BIRCH_LOG 3 12"
        make console execute command "eshop add SPRUCE_LOG 3 12"
        
        # Configurar precios de recursos
        make console execute command "eshop add IRON_INGOT 15 50"
        make console execute command "eshop add GOLD_INGOT 25 75"
        make console execute command "eshop add DIAMOND 50 150"
        make console execute command "eshop add EMERALD 40 120"
        make console execute command "eshop add COAL 5 15"
        make console execute command "eshop add REDSTONE 5 15"
        make console execute command "eshop add LAPIS_LAZULI 8 24"
        
        # Configurar precios de comida
        make console execute command "eshop add BREAD 2 6"
        make console execute command "eshop add COOKED_BEEF 5 15"
        make console execute command "eshop add COOKED_CHICKEN 4 12"
        make console execute command "eshop add GOLDEN_APPLE 100 300"
        make console execute command "eshop add CAKE 20 60"
        
        # Configurar precios de herramientas
        make console execute command "eshop add DIAMOND_PICKAXE 200 600"
        make console execute command "eshop add DIAMOND_AXE 200 600"
        make console execute command "eshop add DIAMOND_SHOVEL 150 450"
        make console execute command "eshop add DIAMOND_HOE 150 450"
        
        # Configurar precios de armas
        make console execute command "eshop add DIAMOND_SWORD 180 540"
        make console execute command "eshop add BOW 50 150"
        make console execute command "eshop add ARROW 1 3"
        
        # Configurar precios de armadura
        make console execute command "eshop add DIAMOND_HELMET 200 600"
        make console execute command "eshop add DIAMOND_CHESTPLATE 300 900"
        make console execute command "eshop add DIAMOND_LEGGINGS 250 750"
        make console execute command "eshop add DIAMOND_BOOTS 200 600"
        
        # Configurar precios de decoración
        make console execute command "eshop add GLASS 2 6"
        make console execute command "eshop add LANTERN 10 30"
        make console execute command "eshop add FLOWER_POT 5 15"
        make console execute command "eshop add PAINTING 10 30"
        
        # Configurar precios especiales
        make console execute command "eshop add DRAGON_EGG 10000 30000"
        make console execute command "eshop add ELYTRA 5000 15000"
        make console execute command "eshop add BEACON 2000 6000"
        
        send "&a¡Tienda configurada exitosamente!" to player
        send "&ePuedes acceder a la tienda con /eshop" to player